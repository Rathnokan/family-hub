{
  "name": "family-hub",
  "version": "1.0.0",
  "description": "A private, self-hosted family task management integration for Home Assistant.",
  "main": "index.js",
  "scripts": {
    "gen-build-id": "node gen-build-id.mjs",
    "build:stub": "esbuild src/main.js --bundle --format=iife --target=chrome80 --outfile=custom_components/family_hub/www/family-hub-card.js",
    "build:body": "esbuild src/body.js --bundle --minify --format=esm --target=chrome80 --outfile=custom_components/family_hub/www/family-hub-card-body.js",
    "build": "npm run gen-build-id && npm run build:stub && npm run build:body",
    "watch:stub": "npm run build:stub -- --watch",
    "watch:body": "npm run build:body -- --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rathnokan/family-hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Rathnokan/family-hub/issues"
  },
  "homepage": "https://github.com/Rathnokan/family-hub#readme",
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}